---
interface Props {
  currentPath?: string;
  transparent?: boolean;
}

const { currentPath = '', transparent = false } = Astro.props;

const navLinks = [
  { label: 'App', href: '/medito-app' },
  { label: 'About', href: '/about' },
  { label: 'Research', href: '/research' },
  { label: 'Contact', href: '/contact' },
];
---

<header class={`fixed top-0 w-full z-50 px-6 ${transparent ? 'bg-ink/30 backdrop-blur-sm' : 'bg-warm-50/90 backdrop-blur-sm'}`}>
  <div class="max-w-[768px] mx-auto h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src="/logo.png" alt="Medito Foundation" class={`h-7 w-7 ${transparent ? 'invert' : ''}`} />
      <span class={`text-[15px] font-medium tracking-tight ${transparent ? 'text-warm-50' : 'text-ink'}`}>Medito Foundation</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden sm:flex items-center gap-5">
      {navLinks.map(link => (
        <a
          href={link.href}
          data-ga={`header_nav_${link.label.toLowerCase()}`}
          class={`text-[14px] transition-colors duration-300 ${
            transparent
              ? 'text-warm-50/70 hover:text-warm-50'
              : currentPath === link.href ? 'text-ink font-medium' : 'text-ink-light hover:text-ink'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://donate.meditofoundation.org/"
        target="_blank"
        rel="noopener"
        data-ga="header_nav_donate"
        class={`text-[14px] font-medium ml-1 ${transparent ? 'text-warm-50' : 'text-ink'}`}
      >
        Donate &rarr;
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class={`sm:hidden p-1 ${transparent ? 'text-warm-50' : 'text-ink'}`}
      aria-label="Toggle menu"
    >
      <svg id="menu-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden sm:hidden max-w-[768px] mx-auto pb-6">
    <nav class="flex flex-col gap-3">
      {navLinks.map(link => (
        <a
          href={link.href}
          data-ga={`header_nav_${link.label.toLowerCase()}`}
          class={`text-[15px] py-1 transition-colors duration-300 ${
            transparent
              ? 'text-warm-50/70 hover:text-warm-50'
              : currentPath === link.href ? 'text-ink font-medium' : 'text-ink-light hover:text-ink'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://donate.meditofoundation.org/"
        target="_blank"
        rel="noopener"
        data-ga="header_nav_donate"
        class={`text-[15px] font-medium py-1 ${transparent ? 'text-warm-50' : 'text-ink'}`}
      >
        Donate &rarr;
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
