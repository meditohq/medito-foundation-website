---
// Floating QR code shown on desktop only
---

<div id="qr-float" class="hidden lg:flex fixed bottom-6 right-6 z-50 flex-col items-center bg-cta rounded-2xl shadow-2xl p-5 pt-4 text-center whitespace-nowrap animate-fade-in">
  <button id="qr-close" class="absolute top-2.5 right-3 text-white hover:text-warm-50 text-[14px] leading-none transition-colors duration-200" aria-label="Close">&times;</button>
  <p class="text-[12px] font-medium uppercase tracking-[0.08em] text-white mb-3">Get the app</p>
  <div class="bg-white rounded-lg p-2">
    <img src="/qr-download.png" alt="QR code to download Medito" width="120" height="120" />
  </div>
  <p class="mt-3 text-[14px] font-medium text-warm-50 leading-[1.3]">Scan to download</p>
  <p class="mt-0.5 text-[12px] font-medium text-white">Free on iOS & Android</p>
</div>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.4s ease-out;
  }
</style>

<script is:inline>
  document.getElementById('qr-close')?.addEventListener('click', function () {
    var el = document.getElementById('qr-float');
    if (el) {
      el.style.transition = 'opacity 0.2s, transform 0.2s';
      el.style.opacity = '0';
      el.style.transform = 'translateY(12px)';
      setTimeout(function () { el.remove(); }, 200);
    }
  });
</script>
